{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "contracts/**/*.ts",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "server/**/*.ts",
    "adapters/**/*.ts",
    "web/office-model.js"
  ]
}
